# TTSFR Platform Environment Configuration

# Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=ttsfr_db
POSTGRES_USER=ttsfr_user
POSTGRES_PASSWORD=ttsfr_secure_password_2026
DATABASE_URL=postgresql://ttsfr_user:ttsfr_secure_password_2026@db:5432/ttsfr_db

# Backend (FastAPI)
PROJECT_NAME="Plateforme TTSFR"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_super_secret_generated_jwt_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="TTSFR Coopératives"
